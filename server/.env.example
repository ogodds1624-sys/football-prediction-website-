# Copy this file to ".env" and fill in your own values.
# NEVER commit .env or share it. It is listed in .gitignore.

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# The public address of this site. Payment providers send users back here.
# Locally: http://localhost:3000   In production: https://yourdomain.com
APP_URL=http://localhost:3000
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Currency charged for plans (prices live in src/plans.js, in pesewas/kobo/cents).
CURRENCY=GHS

# --- Paystack (dashboard.paystack.com > Settings > API Keys & Webhooks) --
# Test keys start with sk_test_ / pk_test_. Live keys start with sk_live_ / pk_live_.
# The SECRET key stays on the server only. Leave blank to turn Paystack off.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public keys are safe in a browser. This app uses redirect checkout, so it
# does not need them, but keep them here if you add the inline popup later.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Flutterwave (dashboard.flutterwave.com > Settings > API Keys) ------
# Test keys contain _TEST. Leave the secret blank to turn Flutterwave off.
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Any random string. Paste the SAME value into Flutterwave > Settings >
# Webhooks > "Secret hash". Flutterwave sends it back on every webhook.
FLW_WEBHOOK_HASH=replace-with-another-random-string

# --- Database -------------------------------------------------------------
# SQLite file. Defaults to server/data/app.db when left blank.
DATABASE_FILE=
